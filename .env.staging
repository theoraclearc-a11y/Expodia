# Staging Configuration
NODE_ENV=staging
APP_PORT=3000
APP_HOST=0.0.0.0

# Database Configuration (staging database)
DB_HOST=${STAGING_DB_HOST}
DB_PORT=5432
DB_NAME=${STAGING_DB_NAME}
DB_USER=${STAGING_DB_USER}
DB_PASSWORD=${STAGING_DB_PASSWORD}
DB_DIALECT=postgres

# API Configuration
API_BASE_URL=${STAGING_API_BASE_URL}
API_TIMEOUT=30000

# Authentication
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Flight Search API
FLIGHT_API_KEY=${STAGING_FLIGHT_API_KEY}
FLIGHT_API_BASE_URL=${STAGING_FLIGHT_API_BASE_URL}

# CORS Configuration
CORS_ORIGIN=${STAGING_CORS_ORIGIN}

# Redis
REDIS_HOST=${STAGING_REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}

# Email Configuration
SMTP_HOST=${STAGING_SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${STAGING_SMTP_USER}
SMTP_PASSWORD=${STAGING_SMTP_PASSWORD}
SMTP_FROM=noreply@staging.expodia.com
