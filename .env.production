# Production Configuration
NODE_ENV=production
APP_PORT=3000
APP_HOST=0.0.0.0

# Database Configuration (use production database)
DB_HOST=${PROD_DB_HOST}
DB_PORT=5432
DB_NAME=${PROD_DB_NAME}
DB_USER=${PROD_DB_USER}
DB_PASSWORD=${PROD_DB_PASSWORD}
DB_DIALECT=postgres
DB_SSL=true

# API Configuration
API_BASE_URL=${PROD_API_BASE_URL}
API_TIMEOUT=30000

# Authentication
JWT_SECRET=${PROD_JWT_SECRET}
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json

# Flight Search API
FLIGHT_API_KEY=${PROD_FLIGHT_API_KEY}
FLIGHT_API_BASE_URL=${PROD_FLIGHT_API_BASE_URL}

# CORS Configuration
CORS_ORIGIN=${PROD_CORS_ORIGIN}

# Redis (production instance)
REDIS_HOST=${PROD_REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${PROD_REDIS_PASSWORD}

# Email Configuration
SMTP_HOST=${PROD_SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${PROD_SMTP_USER}
SMTP_PASSWORD=${PROD_SMTP_PASSWORD}
SMTP_FROM=noreply@expodia.com

# Monitoring & Analytics
SENTRY_DSN=${PROD_SENTRY_DSN}
